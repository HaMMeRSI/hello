---
import type { Project } from '../../content/profile/projects';
import Icon from '../Icon/index.astro';
import './index.css';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const [preview] = project.media;
const previewImage = preview.type === 'image' ? preview.src : preview.poster;
const loading = eager ? 'eager' : 'lazy';
const hasGallery = project.media.length > 1;
const titleId = `project-${project.slug}-title`;
const clientMedia = project.media.map(item => (item.type === 'image' ? { ...item, src: item.src.src } : { ...item, poster: item.poster.src }));
---

<article
  class="project-feature reveal"
  aria-labelledby={titleId}
  data-project-carousel
  data-media={JSON.stringify(clientMedia)}
  data-active-index="0"
  data-project-name={project.name}
  data-project-slug={project.slug}>
  <figure class="feature-media">
    <div class="project-preview" role="group" aria-label={`${project.name} preview`}>
      <span class="project-preview-frame" data-preview-frame>
        {
          preview.type === 'image' ? (
            <img
              src={previewImage.src}
              width={previewImage.width}
              height={previewImage.height}
              alt={preview.alt}
              loading={loading}
              fetchpriority={eager ? 'high' : 'auto'}
              decoding="async"
            />
          ) : (
            <button type="button" class="project-video-poster" data-video-poster aria-label={`Play ${preview.alt}`}>
              <img src={previewImage.src} width={previewImage.width} height={previewImage.height} alt="" loading={loading} decoding="async" />
              <span class="project-video-play" aria-hidden="true">
                <Icon name="play" size={22} />
              </span>
            </button>
          )
        }
      </span>

      {
        hasGallery && (
          <>
            <div class="project-carousel-controls" role="group" aria-label={`${project.name} carousel controls`}>
              <button type="button" class="project-carousel-button project-carousel-prev" data-carousel-step="-1" aria-label={`Previous ${project.name} media`}>
                <Icon name="chevronLeft" size={24} />
              </button>
              <button type="button" class="project-carousel-button project-carousel-next" data-carousel-step="1" aria-label={`Next ${project.name} media`}>
                <Icon name="chevronRight" size={24} />
              </button>
            </div>
            <span class="project-carousel-count" aria-live="polite" data-carousel-count>
              1 / {project.media.length}
            </span>
          </>
        )
      }
    </div>

    {
      hasGallery && (
        <div class="feature-slider" role="group" aria-label={`${project.name} gallery thumbnails`}>
          {project.media.map((item, index) => {
            const thumbnail = item.type === 'image' ? item.src : item.poster;
            return (
              <button
                type="button"
                class:list={['project-thumb', index === 0 && 'project-thumb-active']}
                data-carousel-thumb={index}
                aria-label={`Show ${item.alt}`}
                aria-pressed={index === 0 ? 'true' : 'false'}>
                <span class="project-thumb-frame" aria-hidden="true">
                  <img src={thumbnail.src} width={thumbnail.width} height={thumbnail.height} alt="" loading="lazy" decoding="async" />
                  {item.type !== 'image' && (
                    <span class="project-thumb-video" aria-hidden="true">
                      <Icon name="play" size={12} />
                    </span>
                  )}
                </span>
              </button>
            );
          })}
        </div>
      )
    }
  </figure>

  <div class="feature-content">
    <p class="project-tag">
      {project.type}
      <span class="project-tag-dot" aria-hidden="true"></span>
      {project.status}
    </p>
    <h3 class="project-name" id={titleId}>
      {
        project.url ? (
          <a
            class="project-link"
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open ${project.name} website in a new tab`}
            data-track="project_link_clicked"
            data-track-props={JSON.stringify({ project_name: project.name, project_slug: project.slug })}>
            {project.name}
            <span class="project-link-arrow" aria-hidden="true">
              <Icon name="externalLink" size={14} />
            </span>
          </a>
        ) : (
          project.name
        )
      }
    </h3>
    <p class="project-summary">{project.summary}</p>

    <ul class="project-highlights">
      {project.highlights.map(highlight => <li>{highlight}</li>)}
    </ul>

    <ul class="project-chips">
      {project.details.map(detail => <li class="project-chip">{detail}</li>)}
    </ul>
  </div>

  <template data-play-icon-template>
    <Icon name="play" size={22} />
  </template>
</article>

<script>
  type ClientMedia = { type: 'image'; src: string; alt: string } | { type: 'video' | 'youtube'; src: string; poster: string; alt: string };

  const createImage = (src: string, alt: string) => {
    const image = document.createElement('img');
    image.src = src;
    image.alt = alt;
    image.decoding = 'async';
    return image;
  };

  const createVideoPoster = (feature: HTMLElement, media: Exclude<ClientMedia, { type: 'image' }>) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'project-video-poster';
    button.dataset.videoPoster = '';
    button.setAttribute('aria-label', `Play ${media.alt}`);

    const play = document.createElement('span');
    play.className = 'project-video-play';
    play.setAttribute('aria-hidden', 'true');
    play.append(feature.querySelector<HTMLTemplateElement>('[data-play-icon-template]')!.content.cloneNode(true));

    button.append(createImage(media.poster, ''), play);
    return button;
  };

  const createPlayer = (media: Exclude<ClientMedia, { type: 'image' }>) => {
    if (media.type === 'youtube') {
      const iframe = document.createElement('iframe');
      iframe.src = `${media.src}?autoplay=1`;
      iframe.title = media.alt;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      return iframe;
    }

    const video = document.createElement('video');
    video.src = media.src;
    video.poster = media.poster;
    video.controls = true;
    video.playsInline = true;
    video.autoplay = true;
    video.setAttribute('aria-label', media.alt);
    return video;
  };

  const showMedia = (feature: HTMLElement, media: ClientMedia[], index: number, play = false) => {
    const activeIndex = (index + media.length) % media.length;
    const active = media[activeIndex];
    const frame = feature.querySelector<HTMLElement>('[data-preview-frame]')!;

    frame.replaceChildren(active.type === 'image' ? createImage(active.src, active.alt) : play ? createPlayer(active) : createVideoPoster(feature, active));
    // Restart the frame's entry animation for the new media.
    frame.style.animation = 'none';
    void frame.offsetWidth;
    frame.style.animation = '';

    feature.dataset.activeIndex = String(activeIndex);
    const count = feature.querySelector('[data-carousel-count]');
    if (count) count.textContent = `${activeIndex + 1} / ${media.length}`;
    feature.querySelectorAll<HTMLButtonElement>('[data-carousel-thumb]').forEach(thumb => {
      const isActive = Number(thumb.dataset.carouselThumb) === activeIndex;
      thumb.classList.toggle('project-thumb-active', isActive);
      thumb.setAttribute('aria-pressed', String(isActive));
    });
  };

  // astro:page-load fires on the first load and after every client-side navigation.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-project-carousel]').forEach(feature => {
      const media: ClientMedia[] = JSON.parse(feature.dataset.media!);
      const activeIndex = () => Number(feature.dataset.activeIndex);
      const analytics = { project_name: feature.dataset.projectName, project_slug: feature.dataset.projectSlug };

      feature.addEventListener('click', event => {
        const target = event.target as Element;

        if (target.closest('[data-video-poster]')) {
          window.posthog?.capture('project_video_played', analytics);
          showMedia(feature, media, activeIndex(), true);
          return;
        }

        const step = target.closest<HTMLButtonElement>('[data-carousel-step]');
        if (step) {
          showMedia(feature, media, activeIndex() + Number(step.dataset.carouselStep));
          window.posthog?.capture('project_carousel_navigated', { ...analytics, method: 'arrow' });
          return;
        }

        const thumb = target.closest<HTMLButtonElement>('[data-carousel-thumb]');
        if (thumb) {
          showMedia(feature, media, Number(thumb.dataset.carouselThumb));
          window.posthog?.capture('project_carousel_navigated', { ...analytics, method: 'thumbnail' });
        }
      });
    });
  });
</script>
