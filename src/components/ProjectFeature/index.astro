---
import type { Project, ProjectMediaAsset } from '../../content/profile/projects';
import { getAssetUrl, getOrderedMedia } from '../../lib/project-media';
import Icon from '../Icon/index.astro';
import './index.css';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const media = getOrderedMedia(project.media);
const activeMedia = media[0] ?? null;
const hasGallery = media.length > 1;
const highlights = project.highlights ?? [];
const hasHighlights = highlights.length > 0;
const previewBackground =
  project.coverBackground ??
  `radial-gradient(circle at 18% 16%, color-mix(in srgb, ${project.accent} 18%, transparent), transparent 34%), radial-gradient(circle at 84% 82%, rgba(var(--dark-rgb), 0.06), transparent 36%), linear-gradient(135deg, #ffffff 0%, color-mix(in srgb, ${project.accent} 7%, #fdfdfb) 100%)`;
const rowBackground = project.rowBackground ?? 'transparent';
const accentStyle = `--accent: ${project.accent}; --preview-bg: ${previewBackground}; --row-bg: ${rowBackground};`;
const previewClasses = ['project-preview', project.coverFit === 'contain' && !activeMedia && 'project-preview-contain'];
const previewLoading = eager ? 'eager' : 'lazy';
const previewFetchPriority = eager ? 'high' : undefined;

function isLocalImage(asset: ProjectMediaAsset | undefined): asset is ImageMetadata {
  return typeof asset === 'object' && asset !== null && 'src' in asset && 'width' in asset && 'height' in asset;
}

function getImageProps(
  asset: ProjectMediaAsset,
  alt: string,
  loading: 'eager' | 'lazy' = previewLoading,
  fetchpriority: 'high' | undefined = loading === previewLoading ? previewFetchPriority : undefined
) {
  return {
    src: getAssetUrl(asset) ?? '',
    alt,
    loading,
    decoding: 'async' as const,
    ...(fetchpriority ? { fetchpriority } : {}),
    ...(isLocalImage(asset) ? { width: asset.width, height: asset.height } : {}),
  };
}

const getThumbnailImageProps = (asset: ProjectMediaAsset) => getImageProps(asset, '', 'lazy', undefined);

const clientMedia = media.map(item => ({
  type: item.type,
  src: getAssetUrl(item.src) ?? '',
  poster: getAssetUrl(item.poster),
  alt: item.alt,
}));

function initials(name: string) {
  return name
    .replace(/[^a-zA-Z0-9 ]/g, '')
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map(word => word[0]?.toUpperCase())
    .join('');
}

const titleId = `project-${project.slug}-title`;
---

<article
  class="project-feature reveal"
  style={accentStyle}
  aria-labelledby={titleId}
  data-project-carousel
  data-media={JSON.stringify(clientMedia)}
  data-active-index="0"
  data-project-name={project.name}
  data-project-slug={project.slug}>
  <figure class="feature-media">
    <div class:list={previewClasses} role="group" aria-label={`${project.name} preview`}>
      <span class="project-preview-frame" data-preview-frame>
        {
          activeMedia ? (
            activeMedia.type === 'image' ? (
              <img {...getImageProps(activeMedia.src, activeMedia.alt)} />
            ) : (
              <button type="button" class="project-video-poster" data-video-poster aria-label={`Play ${activeMedia.alt}`}>
                {activeMedia.poster ? <img {...getImageProps(activeMedia.poster, '')} alt="" /> : <span class="project-video-poster-fallback" aria-hidden="true" />}
                <span class="project-video-play" aria-hidden="true">
                  <Icon name="play" size={22} />
                </span>
              </button>
            )
          ) : project.cover ? (
            <img {...getImageProps(project.cover, `${project.name} preview`)} />
          ) : (
            <span class="project-preview-placeholder" aria-hidden="true">
              <span class="project-preview-mark">{initials(project.name)}</span>
            </span>
          )
        }
      </span>

      {
        hasGallery && (
          <>
            <div class="project-carousel-controls" role="group" aria-label={`${project.name} carousel controls`}>
              <button type="button" class="project-carousel-button project-carousel-prev" data-carousel-step="-1" aria-label={`Previous ${project.name} media`}>
                <Icon name="chevronLeft" size={24} />
              </button>
              <button type="button" class="project-carousel-button project-carousel-next" data-carousel-step="1" aria-label={`Next ${project.name} media`}>
                <Icon name="chevronRight" size={24} />
              </button>
            </div>
            <span class="project-carousel-count" aria-live="polite" data-carousel-count>
              1 / {media.length}
            </span>
          </>
        )
      }
    </div>

    {
      hasGallery && (
        <div class="feature-slider" role="group" aria-label={`${project.name} gallery thumbnails`}>
          {media.map((item, index) => (
            <button
              type="button"
              class:list={['project-thumb', index === 0 && 'project-thumb-active']}
              data-carousel-thumb={index}
              aria-label={`Show ${item.alt}`}
              aria-pressed={index === 0 ? 'true' : 'false'}>
              <span class="project-thumb-frame" aria-hidden="true">
                {item.type === 'image' ? (
                  <img {...getThumbnailImageProps(item.src)} alt="" />
                ) : (
                  <>
                    {item.poster && <img {...getThumbnailImageProps(item.poster)} alt="" />}
                    <span class="project-thumb-video" aria-hidden="true">
                      <Icon name="play" size={12} />
                    </span>
                  </>
                )}
              </span>
            </button>
          ))}
        </div>
      )
    }
  </figure>

  <div class="feature-content">
    <p class="project-tag">
      {project.type}
      <span class="project-tag-dot" aria-hidden="true"></span>
      {project.status}
    </p>
    <h3 class="project-name" id={titleId}>
      {
        project.url ? (
          <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name} website in a new tab`} data-project-link>
            {project.name}
            <span class="project-link-arrow" aria-hidden="true">
              <Icon name="externalLink" size={14} />
            </span>
          </a>
        ) : (
          project.name
        )
      }
    </h3>
    <p class="project-summary">{project.summary}</p>

    {
      hasHighlights && (
        <ul class="project-highlights">
          {highlights.map(highlight => (
            <li>{highlight}</li>
          ))}
        </ul>
      )
    }

    <ul class="project-chips">
      {project.details.map(detail => <li class="project-chip">{detail}</li>)}
    </ul>
  </div>

  <template data-play-icon-template>
    <Icon name="play" size={22} />
  </template>
</article>

<script>
  import { getYouTubeEmbedUrl } from '../../lib/project-media';

  const carouselSelector = '[data-project-carousel]';
  const previewFrameSelector = '[data-preview-frame]';
  const stepSelector = '[data-carousel-step]';
  const thumbSelector = '[data-carousel-thumb]';
  const carouselCountSelector = '[data-carousel-count]';
  const videoPosterSelector = '[data-video-poster]';
  const playIconTemplateSelector = '[data-play-icon-template]';

  type ClientProjectMedia = {
    type: 'image' | 'video';
    src: string;
    poster?: string;
    alt: string;
  };

  const getMediaFromDataset = (feature: HTMLElement) => {
    try {
      const media = JSON.parse(feature.dataset.media || '[]');
      return Array.isArray(media) ? (media as ClientProjectMedia[]) : [];
    } catch {
      return [];
    }
  };

  const createRuntimeImage = (src: string, alt: string) => {
    const image = document.createElement('img');
    image.src = src;
    image.alt = alt;
    image.loading = 'eager';
    image.decoding = 'async';
    return image;
  };

  const createVideoPoster = (feature: HTMLElement, media: ClientProjectMedia) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'project-video-poster';
    button.dataset.videoPoster = 'true';
    button.setAttribute('aria-label', `Play ${media.alt}`);

    if (media.poster) {
      button.append(createRuntimeImage(media.poster, ''));
    } else {
      const fallback = document.createElement('span');
      fallback.className = 'project-video-poster-fallback';
      fallback.setAttribute('aria-hidden', 'true');
      button.append(fallback);
    }

    const play = document.createElement('span');
    play.className = 'project-video-play';
    play.setAttribute('aria-hidden', 'true');
    const playIconTemplate = feature.querySelector<HTMLTemplateElement>(playIconTemplateSelector);
    if (playIconTemplate) play.append(playIconTemplate.content.cloneNode(true));
    button.append(play);
    return button;
  };

  const createPlayableVideoElement = (media: ClientProjectMedia) => {
    const embedUrl = getYouTubeEmbedUrl(media.src);
    if (embedUrl) {
      const iframe = document.createElement('iframe');
      iframe.src = `${embedUrl}?autoplay=1`;
      iframe.title = media.alt;
      iframe.loading = 'lazy';
      iframe.allow = ['accelerometer', 'autoplay', 'clipboard-write', 'encrypted-media', 'gyroscope', 'picture-in-picture', 'web-share'].join('; ');
      iframe.allowFullscreen = true;
      return iframe;
    }

    const video = document.createElement('video');
    video.src = media.src;
    if (media.poster) video.poster = media.poster;
    video.controls = true;
    video.playsInline = true;
    video.preload = 'metadata';
    video.autoplay = true;
    video.setAttribute('aria-label', media.alt);
    return video;
  };

  const getActiveIndex = (feature: HTMLElement) => Number(feature.dataset.activeIndex || 0);

  const createMediaElement = (feature: HTMLElement, media: ClientProjectMedia, activateVideo = false) => {
    if (media.type === 'image') return createRuntimeImage(media.src, media.alt);
    return activateVideo ? createPlayableVideoElement(media) : createVideoPoster(feature, media);
  };

  const wrapIndex = (index: number, length: number) => {
    const safeIndex = Number.isFinite(index) ? index : 0;
    return ((safeIndex % length) + length) % length;
  };

  const setCarouselIndex = (feature: HTMLElement, media: ClientProjectMedia[], nextIndex: number, activateVideo = false) => {
    if (!media.length) return;

    const activeIndex = wrapIndex(nextIndex, media.length);
    const activeMedia = media[activeIndex];
    const frame = feature.querySelector<HTMLElement>(previewFrameSelector);
    if (!frame) return;

    frame.replaceChildren(createMediaElement(feature, activeMedia, activateVideo));
    frame.style.animation = 'none';
    void frame.offsetWidth;
    frame.style.animation = '';

    feature.dataset.activeIndex = String(activeIndex);
    const count = feature.querySelector<HTMLElement>(carouselCountSelector);
    if (count) count.textContent = `${activeIndex + 1} / ${media.length}`;
    feature.querySelectorAll<HTMLButtonElement>(thumbSelector).forEach(thumb => {
      const isActive = Number(thumb.dataset.carouselThumb) === activeIndex;
      thumb.classList.toggle('project-thumb-active', isActive);
      thumb.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
  };

  const initCarousel = (feature: HTMLElement) => {
    if (feature.dataset.carouselReady === 'true') return;

    const media = getMediaFromDataset(feature);
    if (!media.length) return;

    feature.dataset.carouselReady = 'true';

    const projectName = feature.dataset.projectName ?? '';
    const projectSlug = feature.dataset.projectSlug ?? '';

    const projectLink = feature.querySelector<HTMLAnchorElement>('[data-project-link]');
    if (projectLink) {
      projectLink.addEventListener('click', () => {
        window.posthog?.capture('project_link_clicked', { project_name: projectName, project_slug: projectSlug });
      });
    }

    feature.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;

      const posterButton = event.target.closest<HTMLButtonElement>(videoPosterSelector);
      if (posterButton && feature.contains(posterButton)) {
        window.posthog?.capture('project_video_played', { project_name: projectName, project_slug: projectSlug });
        setCarouselIndex(feature, media, getActiveIndex(feature), true);
        return;
      }

      const stepButton = event.target.closest<HTMLButtonElement>(stepSelector);
      if (stepButton && feature.contains(stepButton)) {
        const nextIndex = getActiveIndex(feature) + Number(stepButton.dataset.carouselStep || 0);
        setCarouselIndex(feature, media, nextIndex);
        window.posthog?.capture('project_carousel_navigated', { project_name: projectName, project_slug: projectSlug, method: 'arrow' });
        return;
      }

      const thumbButton = event.target.closest<HTMLButtonElement>(thumbSelector);
      if (thumbButton && feature.contains(thumbButton)) {
        setCarouselIndex(feature, media, Number(thumbButton.dataset.carouselThumb || 0));
        window.posthog?.capture('project_carousel_navigated', { project_name: projectName, project_slug: projectSlug, method: 'thumbnail' });
      }
    });
  };

  const initCarousels = () => {
    document.querySelectorAll<HTMLElement>(carouselSelector).forEach(initCarousel);
  };

  document.addEventListener('astro:page-load', initCarousels);
  initCarousels();
</script>
