---
import shLogo from '../assets/logo/sh.svg?url';
import { navItems, profile } from '../content/profile/site';

const footerLinks = navItems.filter(item => item.to !== '/');

const socialLinks = [
  {
    label: 'Email',
    href: `mailto:${profile.email}`,
    external: false,
    brand: false,
    icon: '<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />',
  },
  {
    label: 'LinkedIn',
    href: profile.linkedin,
    external: true,
    icon: '<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43c-1.14 0-2.06-.93-2.06-2.06s.92-2.06 2.06-2.06S7.4 4.23 7.4 5.37s-.92 2.06-2.06 2.06Zm1.78 13.02H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.23 0Z" />',
    brand: true,
  },
  {
    label: 'GitHub',
    href: profile.github,
    external: true,
    icon: '<path d="M12 .3C5.37.3 0 5.67 0 12.3c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.23c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.3C24 5.67 18.63.3 12 .3Z" />',
    brand: true,
  },
] as const;
---

<footer class="mobile-footer">
  <a class="mobile-footer-logo" href="/" aria-label={`${profile.name} home`}>
    <img src={shLogo} alt="" aria-hidden="true" />
  </a>

  <nav class="mobile-footer-nav" aria-label="Footer navigation">
    {footerLinks.map(link => <a href={link.to}>{link.label}</a>)}
  </nav>

  <hr class="mobile-footer-rule" aria-hidden="true" />

  <nav class="mobile-footer-socials" aria-label="Contact links">
    {
      socialLinks.map(link => {
        const linkProps = link.external ? { target: '_blank', rel: 'noopener' } : {};

        return (
          <a href={link.href} aria-label={link.label} {...linkProps}>
            <svg class:list={[link.brand && 'brand-icon']} viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={link.icon} />
          </a>
        );
      })
    }
  </nav>
</footer>

<style>
  .mobile-footer {
    display: none;
  }

  @media (max-width: 860px) {
    .mobile-footer {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.65rem;
      padding: 0.85rem var(--page-x, clamp(1rem, 5vw, 1.75rem)) 1rem;
      color: var(--dark);
      background: transparent;
      text-align: center;
    }

    .mobile-footer-logo {
      display: inline-flex;
      line-height: 0;
    }

    .mobile-footer-logo img {
      display: block;
      width: 2.2rem;
      height: auto;
    }

    .mobile-footer-nav {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(0.85rem, 5vw, 1.25rem);
      width: 100%;
      color: var(--dark);
      font-family: var(--font-display);
      font-size: 0.76rem;
      font-weight: 800;
      line-height: 1;
    }

    .mobile-footer-rule {
      width: 100%;
      height: 1px;
      border: 0;
      background: rgba(var(--dark-rgb), 0.08);
    }

    .mobile-footer-socials {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(1rem, 7vw, 1.75rem);
      width: 100%;
      color: #101820;
    }

    .mobile-footer-socials a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.2rem;
      height: 1.2rem;
    }

    .mobile-footer-socials svg {
      display: block;
      width: 1rem;
      height: 1rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .mobile-footer-socials svg.brand-icon {
      fill: currentColor;
      stroke: none;
    }
  }
</style>
