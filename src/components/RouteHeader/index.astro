---
import { navItems, profile } from '../../content/profile/site';
import './index.css';

const headerLinks = navItems.filter(item => item.to !== '/');
---

<header class="route-header">
  <a href="/" class="route-logo" aria-label={`${profile.name} home`}>
    <img src="/logo/sh.svg" alt="" aria-hidden="true" width="898" height="643" decoding="sync" fetchpriority="high" />
  </a>

  <nav class="route-links" aria-label="Primary navigation">
    {
      headerLinks.map(item => (
        <a href={item.to} class="route-link" data-track="nav_clicked" data-track-props={JSON.stringify({ destination: item.to, label: item.label })}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
