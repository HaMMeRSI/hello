---
import './LightbulbStage.css';
import brushBottomBlue from '../assets/lightbulb/assets/brush_bottom_blue.webp?url';
import brushPaleBlue from '../assets/lightbulb/assets/brush_pale_blue.webp?url';
import bulbFilaments from '../assets/lightbulb/assets/bulb_filaments.webp?url';
import bulbFull from '../assets/lightbulb/assets/bulb_full.webp?url';
import bulbInnerHighlightArc from '../assets/lightbulb/assets/bulb_inner_highlight_arc.webp?url';
import doodleArrowLeftDashed from '../assets/lightbulb/assets/doodle_arrow_left_dashed.webp?url';
import doodleBlueStar from '../assets/lightbulb/assets/doodle_blue_star.webp?url';
import doodleCircle from '../assets/lightbulb/assets/doodle_circle.webp?url';
import doodleDiagonalArrows from '../assets/lightbulb/assets/doodle_diagonal_arrows.webp?url';
import doodleDiamond from '../assets/lightbulb/assets/doodle_diamond.webp?url';
import doodleSparkLeft from '../assets/lightbulb/assets/doodle_spark_left.webp?url';
import doodleTinyDot from '../assets/lightbulb/assets/doodle_tiny_dot.webp?url';
import doodleTinyX from '../assets/lightbulb/assets/doodle_tiny_x.webp?url';
import doodleVerticalDots from '../assets/lightbulb/assets/doodle_vertical_dots.webp?url';
import doodleXLarge from '../assets/lightbulb/assets/doodle_x_large.webp?url';
import paintInsideBulbBlue from '../assets/lightbulb/assets/paint_inside_bulb_blue.webp?url';

const lightbulbLayers = [
  { className: 'lb-brush-pale', src: brushPaleBlue },
  { className: 'lb-brush-bottom', src: brushBottomBlue },
  { className: 'lb-paint-inside', src: paintInsideBulbBlue },
  { className: 'lb-bulb', src: bulbFull },
  { className: 'lb-filaments', src: bulbFilaments },
  { className: 'lb-arc', src: bulbInnerHighlightArc },
  { className: 'lb-doodle lb-circle', src: doodleCircle },
  { className: 'lb-doodle lb-spark-left', src: doodleSparkLeft },
  { className: 'lb-doodle lb-diag-arrows', src: doodleDiagonalArrows },
  { className: 'lb-doodle lb-diamond', src: doodleDiamond },
  { className: 'lb-doodle lb-right-arrow', src: doodleArrowLeftDashed },
  { className: 'lb-doodle lb-x-large', src: doodleXLarge },
  { className: 'lb-doodle lb-tiny-dot', src: doodleTinyDot },
  { className: 'lb-doodle lb-tiny-x', src: doodleTinyX },
  { className: 'lb-doodle lb-vertical-dots', src: doodleVerticalDots },
  { className: 'lb-doodle lb-blue-star', src: doodleBlueStar },
];
---

<div class="lightbulb-stage" role="img" aria-label="Animated creative spark illustration">
  <canvas class="lb-particles" aria-hidden="true"></canvas>
  <span class="lb-glow"></span>
  <span class="lb-halo"></span>

  {
    lightbulbLayers.map(({ className, src }) => (
      <img class={`lb-asset ${className}`} src={src} alt="" decoding="async" />
    ))
  }

  <span class="lb-micro lb-one"></span>
  <span class="lb-micro lb-two"></span>
  <span class="lb-micro lb-three"></span>
  <span class="lb-micro lb-four"></span>
</div>

<script is:inline data-astro-rerun>
  (() => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduceMotion.matches) return;

    const clampMotion = value => Math.max(-1, Math.min(1, value));

    document.querySelectorAll('.lightbulb-stage').forEach(stage => {
      if (stage.dataset.lightbulbInteractive === 'true') return;
      stage.dataset.lightbulbInteractive = 'true';

      let mx = 0;
      let my = 0;
      let tx = 0;
      let ty = 0;
      let motionRaf = 0;
      let particleRaf = 0;
      let burstTimer = 0;
      let gyroActive = false;
      let gyroOrigin;
      let resize;
      let visible = true;
      let cleaned = false;
      let observer;
      const OrientationEvent = window.DeviceOrientationEvent;

      const canvas = stage.querySelector('.lb-particles');
      const ctx = canvas?.getContext('2d');
      let dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
      let particles = [];

      const stopMotion = () => {
        if (!motionRaf) return;
        cancelAnimationFrame(motionRaf);
        motionRaf = 0;
      };

      const stopParticles = () => {
        if (!particleRaf) return;
        cancelAnimationFrame(particleRaf);
        particleRaf = 0;
      };

      const tickMotion = () => {
        motionRaf = 0;
        if (cleaned || !visible || document.hidden) return;

        mx += (tx - mx) * 0.12;
        my += (ty - my) * 0.12;
        stage.style.setProperty('--mx', mx.toFixed(4));
        stage.style.setProperty('--my', my.toFixed(4));

        if (Math.abs(tx - mx) > 0.001 || Math.abs(ty - my) > 0.001 || gyroActive) {
          motionRaf = requestAnimationFrame(tickMotion);
        }
      };

      const startMotion = () => {
        if (motionRaf || cleaned || !visible || document.hidden) return;
        motionRaf = requestAnimationFrame(tickMotion);
      };

      const setTarget = (x, y) => {
        tx = clampMotion(x);
        ty = clampMotion(y);
        startMotion();
      };

      const onMove = event => {
        setTarget((event.clientX / window.innerWidth - 0.5) * 2, (event.clientY / window.innerHeight - 0.5) * 2);
      };

      const onGyro = event => {
        const { beta, gamma } = event;
        if (beta === null || gamma === null) return;

        gyroOrigin ??= { beta, gamma };
        setTarget((gamma - gyroOrigin.gamma) / 18, (beta - gyroOrigin.beta) / 22);
      };

      const startGyro = () => {
        if (gyroActive) return;
        gyroActive = true;
        gyroOrigin = undefined;
        window.addEventListener('deviceorientation', onGyro);
        startMotion();
      };

      const enableGyro = () => {
        if (!OrientationEvent) return;

        if (typeof OrientationEvent.requestPermission !== 'function') {
          startGyro();
          return;
        }

        void OrientationEvent.requestPermission()
          .then(permission => {
            if (permission === 'granted') startGyro();
          })
          .catch(() => undefined);
      };

      const resizeCanvas = () => {
        if (!canvas || !ctx) return;
        dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
        const width = stage.clientWidth;
        const height = stage.clientHeight;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const tickParticles = () => {
        particleRaf = 0;
        if (cleaned || !visible || document.hidden || !canvas || !ctx) return;

        ctx.save();
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.restore();
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        let activeParticles = 0;
        for (const particle of particles) {
          particle.life++;
          particle.x += particle.vx;
          particle.y += particle.vy;
          particle.vy += 0.018;
          particle.vx *= 0.992;
          particle.vy *= 0.993;
          particle.rot += particle.spin;

          const fade = Math.max(0, 1 - particle.life / particle.max);
          const alpha = Math.min(0.8, fade * 0.78);

          ctx.save();
          ctx.translate(particle.x, particle.y);
          ctx.rotate(particle.rot);
          ctx.fillStyle = `${particle.color}${alpha})`;
          if (Math.random() > 0.5) {
            ctx.fillRect(-particle.r * 1.6, -particle.r * 0.55, particle.r * 3.2, particle.r * 1.1);
          } else {
            ctx.beginPath();
            ctx.arc(0, 0, particle.r, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();

          if (particle.life < particle.max) {
            particles[activeParticles] = particle;
            activeParticles++;
          }
        }

        particles.length = activeParticles;
        if (particles.length > 0) {
          particleRaf = requestAnimationFrame(tickParticles);
        }
      };

      const startParticles = () => {
        if (particleRaf || !particles.length || cleaned || !visible || document.hidden) return;
        particleRaf = requestAnimationFrame(tickParticles);
      };

      const burst = () => {
        if (!canvas || !ctx || cleaned || !visible || document.hidden) return;
        const width = stage.clientWidth;
        const height = stage.clientHeight;
        const cx = width * 0.49;
        const cy = height * 0.42;

        for (let i = 0; i < 70; i++) {
          const angle = -Math.PI * 0.92 + Math.random() * Math.PI * 1.84;
          const speed = 1.2 + Math.random() * 5.4;
          const blue = Math.random() > 0.36;

          particles.push({
            x: cx + (Math.random() - 0.5) * 120,
            y: cy + (Math.random() - 0.5) * 80,
            vx: Math.cos(angle) * speed + (Math.random() - 0.5) * 1.6,
            vy: Math.sin(angle) * speed - 1.6,
            r: blue ? 1 + Math.random() * 3.6 : 0.9 + Math.random() * 2.2,
            rot: Math.random() * Math.PI * 2,
            spin: (Math.random() - 0.5) * 0.16,
            life: 0,
            max: 92 + Math.random() * 72,
            color: blue ? 'rgba(67,85,219,' : 'rgba(0,0,0,',
          });
        }

        startParticles();
      };

      const onVisibilityChange = () => {
        if (document.hidden) {
          stopMotion();
          stopParticles();
          return;
        }

        startMotion();
        startParticles();
      };

      const cleanup = () => {
        if (cleaned) return;
        cleaned = true;

        delete stage.dataset.lightbulbInteractive;
        observer?.disconnect();
        window.removeEventListener('pagehide', cleanup);
        document.removeEventListener('astro:before-swap', cleanup);
        document.removeEventListener('visibilitychange', onVisibilityChange);
        window.removeEventListener('mousemove', onMove);
        window.removeEventListener('pointerdown', enableGyro);
        if (resize) window.removeEventListener('resize', resize);
        if (gyroActive) window.removeEventListener('deviceorientation', onGyro);
        window.clearTimeout(burstTimer);
        stopMotion();
        stopParticles();
      };

      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(entries => {
          visible = entries.some(entry => entry.isIntersecting);
          if (visible) {
            startMotion();
            startParticles();
          } else {
            stopMotion();
            stopParticles();
          }
        });
        observer.observe(stage);
      }

      window.addEventListener('pagehide', cleanup);
      document.addEventListener('astro:before-swap', cleanup);
      document.addEventListener('visibilitychange', onVisibilityChange);
      window.addEventListener('mousemove', onMove, { passive: true });

      const prefersCoarsePointer = window.matchMedia('(hover: none), (pointer: coarse)').matches;
      if (prefersCoarsePointer && OrientationEvent) {
        if (typeof OrientationEvent.requestPermission === 'function') {
          window.addEventListener('pointerdown', enableGyro, { once: true, passive: true });
        } else {
          startGyro();
        }
      }

      if (canvas && ctx) {
        resize = resizeCanvas;
        resize();
        window.addEventListener('resize', resize);
        burstTimer = window.setTimeout(burst, 1250);
      }
    });
  })();
</script>
