---
import './index.css';

const lightbulbLayers = [
  ['lb-brush-pale', 'brush_pale_blue'],
  ['lb-brush-bottom', 'brush_bottom_blue'],
  ['lb-paint-inside', 'paint_inside_bulb_blue'],
  ['lb-bulb', 'bulb_full'],
  ['lb-filaments', 'bulb_filaments'],
  ['lb-arc', 'bulb_inner_highlight_arc'],
  ['lb-doodle lb-circle', 'doodle_circle'],
  ['lb-doodle lb-spark-left', 'doodle_spark_left'],
  ['lb-doodle lb-diag-arrows', 'doodle_diagonal_arrows'],
  ['lb-doodle lb-diamond', 'doodle_diamond'],
  ['lb-doodle lb-right-arrow', 'doodle_arrow_left_dashed'],
  ['lb-doodle lb-x-large', 'doodle_x_large'],
  ['lb-doodle lb-tiny-dot', 'doodle_tiny_dot'],
  ['lb-doodle lb-tiny-x', 'doodle_tiny_x'],
  ['lb-doodle lb-vertical-dots', 'doodle_vertical_dots'],
  ['lb-doodle lb-blue-star', 'doodle_blue_star'],
] as const;

const lightbulbAssets = import.meta.glob('../../assets/lightbulb/assets/*.webp', {
  eager: true,
  import: 'default',
  query: '?url',
}) as Record<string, string>;

const assetUrl = (name: string) => lightbulbAssets[`../../assets/lightbulb/assets/${name}.webp`];
const microFlecks = ['one', 'two', 'three', 'four'] as const;
---

<div class="lightbulb-stage" role="img" aria-label="Animated creative spark illustration">
  <canvas class="lb-particles" aria-hidden="true"></canvas>
  <span class="lb-glow"></span>
  <span class="lb-halo"></span>

  {lightbulbLayers.map(([className, assetName]) => <img class:list={['lb-asset', className]} src={assetUrl(assetName)} alt="" decoding="async" />)}

  {microFlecks.map(fleck => <span class={`lb-micro lb-${fleck}`} />)}
</div>

<script is:inline data-astro-rerun>
  (() => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const PARTICLE_COUNT = 70;
    const STAGE_SELECTOR = '.lightbulb-stage';
    const clampMotion = value => Math.max(-1, Math.min(1, value));
    const randomOffset = amount => (Math.random() - 0.5) * amount;
    const cappedDpr = () => Math.max(1, Math.min(2, window.devicePixelRatio || 1));

    const initStage = stage => {
      if (stage.dataset.lightbulbInteractive === 'true') return;
      stage.dataset.lightbulbInteractive = 'true';

      let mx = 0;
      let my = 0;
      let tx = 0;
      let ty = 0;
      let motionRaf = 0;
      let particleRaf = 0;
      let burstTimer = 0;
      let gyroActive = false;
      let gyroOrigin;
      let visible = true;
      let cleaned = false;
      let observer;
      const OrientationEvent = window.DeviceOrientationEvent;

      const canvas = stage.querySelector('.lb-particles');
      const ctx = canvas?.getContext('2d');
      const particles = [];
      let dpr = cappedDpr();

      const isPaused = () => cleaned || !visible || document.hidden;

      const stopMotion = () => {
        if (!motionRaf) return;
        cancelAnimationFrame(motionRaf);
        motionRaf = 0;
      };

      const stopParticles = () => {
        if (!particleRaf) return;
        cancelAnimationFrame(particleRaf);
        particleRaf = 0;
      };

      const tickMotion = () => {
        motionRaf = 0;
        if (isPaused()) return;

        mx += (tx - mx) * 0.12;
        my += (ty - my) * 0.12;
        stage.style.setProperty('--mx', mx.toFixed(4));
        stage.style.setProperty('--my', my.toFixed(4));

        if (Math.abs(tx - mx) > 0.001 || Math.abs(ty - my) > 0.001 || gyroActive) {
          startMotion();
        }
      };

      const startMotion = () => {
        if (motionRaf || isPaused()) return;
        motionRaf = requestAnimationFrame(tickMotion);
      };

      const setTarget = (x, y) => {
        tx = clampMotion(x);
        ty = clampMotion(y);
        startMotion();
      };

      const onMove = event => {
        setTarget((event.clientX / window.innerWidth - 0.5) * 2, (event.clientY / window.innerHeight - 0.5) * 2);
      };

      const onGyro = event => {
        const { beta, gamma } = event;
        if (beta === null || gamma === null) return;

        gyroOrigin ??= { beta, gamma };
        setTarget((gamma - gyroOrigin.gamma) / 18, (beta - gyroOrigin.beta) / 22);
      };

      const startGyro = () => {
        if (gyroActive || !OrientationEvent) return;
        gyroActive = true;
        gyroOrigin = undefined;
        window.addEventListener('deviceorientation', onGyro, { passive: true });
        startMotion();
      };

      const enableGyro = () => {
        if (!OrientationEvent) return;

        if (typeof OrientationEvent.requestPermission !== 'function') {
          startGyro();
          return;
        }

        void OrientationEvent.requestPermission()
          .then(permission => {
            if (permission === 'granted') startGyro();
          })
          .catch(() => undefined);
      };

      const resizeCanvas = () => {
        if (!canvas || !ctx) return;
        dpr = cappedDpr();
        const width = stage.clientWidth;
        const height = stage.clientHeight;
        const pixelWidth = Math.round(width * dpr);
        const pixelHeight = Math.round(height * dpr);

        if (canvas.width !== pixelWidth) canvas.width = pixelWidth;
        if (canvas.height !== pixelHeight) canvas.height = pixelHeight;

        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const tickParticles = () => {
        particleRaf = 0;
        if (isPaused() || !canvas || !ctx) return;

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, canvas.width / dpr, canvas.height / dpr);

        let activeParticles = 0;
        for (const particle of particles) {
          particle.life++;
          particle.x += particle.vx;
          particle.y += particle.vy;
          particle.vy += 0.018;
          particle.vx *= 0.992;
          particle.vy *= 0.993;
          particle.rot += particle.spin;

          const fade = Math.max(0, 1 - particle.life / particle.max);
          const alpha = Math.min(0.8, fade * 0.78);

          ctx.save();
          ctx.translate(particle.x, particle.y);
          ctx.rotate(particle.rot);
          ctx.fillStyle = `${particle.color}${alpha})`;
          if (Math.random() > 0.5) {
            ctx.fillRect(-particle.r * 1.6, -particle.r * 0.55, particle.r * 3.2, particle.r * 1.1);
          } else {
            ctx.beginPath();
            ctx.arc(0, 0, particle.r, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();

          if (particle.life < particle.max) {
            particles[activeParticles] = particle;
            activeParticles++;
          }
        }

        particles.length = activeParticles;
        if (particles.length > 0) {
          particleRaf = requestAnimationFrame(tickParticles);
        }
      };

      const startParticles = () => {
        if (particleRaf || !particles.length || isPaused()) return;
        particleRaf = requestAnimationFrame(tickParticles);
      };

      const burst = () => {
        if (!canvas || !ctx || isPaused()) return;
        const width = stage.clientWidth;
        const height = stage.clientHeight;
        const cx = width * 0.49;
        const cy = height * 0.42;

        for (let i = 0; i < PARTICLE_COUNT; i++) {
          const angle = -Math.PI * 0.92 + Math.random() * Math.PI * 1.84;
          const speed = 1.2 + Math.random() * 5.4;
          const blue = Math.random() > 0.36;

          particles.push({
            x: cx + randomOffset(120),
            y: cy + randomOffset(80),
            vx: Math.cos(angle) * speed + randomOffset(1.6),
            vy: Math.sin(angle) * speed - 1.6,
            r: blue ? 1 + Math.random() * 3.6 : 0.9 + Math.random() * 2.2,
            rot: Math.random() * Math.PI * 2,
            spin: randomOffset(0.16),
            life: 0,
            max: 92 + Math.random() * 72,
            color: blue ? 'rgba(67,85,219,' : 'rgba(0,0,0,',
          });
        }

        startParticles();
      };

      const syncPlayback = () => {
        if (isPaused()) {
          stopMotion();
          stopParticles();
          return;
        }

        startMotion();
        startParticles();
      };

      const cleanup = () => {
        if (cleaned) return;
        cleaned = true;

        delete stage.dataset.lightbulbInteractive;
        observer?.disconnect();
        window.removeEventListener('pagehide', cleanup);
        document.removeEventListener('astro:before-swap', cleanup);
        document.removeEventListener('visibilitychange', syncPlayback);
        window.removeEventListener('mousemove', onMove);
        window.removeEventListener('pointerdown', enableGyro);
        window.removeEventListener('resize', resizeCanvas);
        window.removeEventListener('deviceorientation', onGyro);
        window.clearTimeout(burstTimer);
        stopMotion();
        stopParticles();
      };

      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(entries => {
          visible = entries.some(entry => entry.isIntersecting);
          syncPlayback();
        });
        observer.observe(stage);
      }

      window.addEventListener('pagehide', cleanup);
      document.addEventListener('astro:before-swap', cleanup);
      document.addEventListener('visibilitychange', syncPlayback);
      window.addEventListener('mousemove', onMove, { passive: true });

      const prefersCoarsePointer = window.matchMedia('(hover: none), (pointer: coarse)').matches;
      if (prefersCoarsePointer && OrientationEvent) {
        if (typeof OrientationEvent.requestPermission === 'function') {
          window.addEventListener('pointerdown', enableGyro, { once: true, passive: true });
        } else {
          startGyro();
        }
      }

      if (canvas && ctx) {
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);
        burstTimer = window.setTimeout(burst, 1250);
      }
    };

    document.querySelectorAll(STAGE_SELECTOR).forEach(initStage);
  })();
</script>
