---
import Icon from '../Icon/index.astro';
import './index.css';

interface Props {
  href: string;
  eyebrow: string;
  label: string;
  asideHref?: string;
  asideLabel?: string;
}

const { href, eyebrow, label, asideHref, asideLabel } = Astro.props;
---

<footer class="story-next">
  <a href={href} class="next-link" data-story-next data-destination={href} data-label={label}>
    <small>{eyebrow}</small>
    <strong>
      {label}
      <Icon name="arrowRight" size={24} />
    </strong>
  </a>

  {
    asideHref && asideLabel && (
      <a href={asideHref} class="story-aside-link" data-story-next data-destination={asideHref} data-label={asideLabel}>
        {asideLabel}
      </a>
    )
  }
</footer>

<script is:inline>
  function setupStoryNext() {
    document.querySelectorAll('[data-story-next]').forEach(function (el) {
      el.removeEventListener('click', el._phStoryNextHandler);
      el._phStoryNextHandler = function () {
        window.posthog?.capture('story_next_clicked', {
          destination: el.dataset.destination,
          label: el.dataset.label,
        });
      };
      el.addEventListener('click', el._phStoryNextHandler);
    });
  }

  document.addEventListener('DOMContentLoaded', setupStoryNext);
  document.addEventListener('astro:page-load', setupStoryNext);
</script>
