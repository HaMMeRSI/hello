---
import Icon from '../Icon/index.astro';
import './index.css';

interface Props {
  href: string;
  eyebrow: string;
  label: string;
  asideHref?: string;
  asideLabel?: string;
}

const { href, eyebrow, label, asideHref, asideLabel } = Astro.props;
---

<footer class="story-next">
  <a href={href} class="next-link" data-track="story_next_clicked" data-track-props={JSON.stringify({ destination: href, label })}>
    <small>{eyebrow}</small>
    <strong>
      {label}
      <Icon name="arrowRight" size={24} />
    </strong>
  </a>

  {
    asideHref && asideLabel && (
      <a href={asideHref} class="story-aside-link" data-track="story_next_clicked" data-track-props={JSON.stringify({ destination: asideHref, label: asideLabel })}>
        {asideLabel}
      </a>
    )
  }
</footer>
