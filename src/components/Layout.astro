---
import { ClientRouter } from 'astro:transitions';
import MobileFooter from './MobileFooter.astro';
import RouteHeader from './RouteHeader.astro';
import { profile } from '../content/profile/site';
import '../main.css';
import '../styles/shell.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = profile.name, description = profile.headline } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kalam:wght@400;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,900;6..12,1000&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script>
      const normalizeTransitionPath = (path: string) => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);

      document.addEventListener('astro:before-swap', event => {
        const transition = event.viewTransition;
        if (!transition || !('types' in transition)) return;

        const from = normalizeTransitionPath(event.from.pathname);
        const to = normalizeTransitionPath(event.to.pathname);
        if (from === to) return;

        if (from === '/') transition.types.add('home-leave');
        if (to === '/') transition.types.add('home-enter');
      });
    </script>
  </head>
  <body>
    <div class="site-shell">
      <RouteHeader />

      <slot />

      <MobileFooter />
    </div>
  </body>
</html>
