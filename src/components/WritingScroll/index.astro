---
/* The home page below the hero: a dark stage where a brick light bulb
   gets built while the essays scroll past, one full-height chapter per
   piece, cards alternating sides. The last chapter switches it on. */
import { getCollection } from 'astro:content';
import plan from '../../lib/lego/bulb.js';
import Icon from '../Icon/index.astro';
import './index.css';

const posts = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
const steps = plan.steps.length;
const bricks = plan.steps.flat().length;
---

<section class="writing-scroll" aria-label="Blog">
  <div class="ws-stage">
    <canvas aria-hidden="true"></canvas>

    <div class="ws-hint" data-hint>Scroll to build</div>
    <div class="ws-drag-hint" aria-hidden="true">Drag to rotate</div>
  </div>

  {
    posts.map((post, index) => {
      const [before, after] = post.data.title.split(post.data.emphasis);

      return (
        <article class:list={['ws-chapter', index % 2 ? 'right' : 'left']}>
          <div class="ws-card reveal">
            <span class="ws-label">
              {String(index + 1).padStart(2, '0')} · {post.data.kicker}
            </span>
            {/* one expression, so formatting never slips whitespace between the parts */}
            <h3>{[before, <em>{post.data.emphasis}</em>, after]}</h3>
            <p>{post.data.hook}</p>
            <a href={`/blog/${post.id}`} class="ws-read" data-track="writing_card_clicked" data-track-props={JSON.stringify({ slug: post.id })}>
              Read the piece
              <Icon name="arrowRight" size={16} />
            </a>
          </div>
        </article>
      );
    })
  }

  <div class="ws-chapter end">
    <div class="ws-card reveal">
      <h3>
        Switch it <em>on</em>.
      </h3>
      <p>{bricks} bricks in {steps} steps, all standing on the blue one. Every piece above is the same move: see the problem, define it, hand it to the AI.</p>
      <div class="ws-end-actions">
        <a href="/start" class="ws-btn-primary" data-track="writing_end_clicked" data-track-props={JSON.stringify({ cta: 'start_papp' })}>
          Build your first PaPP
          <Icon name="arrowRight" size={16} />
        </a>
        <a href="/blog" class="ws-btn-ghost" data-track="writing_end_clicked" data-track-props={JSON.stringify({ cta: 'all_writing' })}>
          All posts
          <Icon name="arrowRight" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // three.js is most of the home page's JavaScript, so it loads only once the stage nears the viewport.
  let stop: (() => void) | undefined;
  document.addEventListener('astro:page-load', () => {
    const stage = document.querySelector<HTMLElement>('.writing-scroll');
    if (!stage) return;

    new IntersectionObserver(
      async (entries, observer) => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        observer.disconnect();
        const [{ default: plan }, { run }] = await Promise.all([import('../../lib/lego/bulb.js'), import('../../lib/lego/engine.js')]);
        // The visitor may have navigated away while the chunk loaded.
        if (stage.isConnected) stop = run(plan, stage, document.querySelector('.site-shell')!);
      },
      { rootMargin: '100% 0px' }
    ).observe(stage);
  });
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = undefined;
  });
</script>
