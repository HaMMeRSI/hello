---
import Icon from '../components/Icon/index.astro';
import Layout from '../components/Layout/index.astro';
import LightbulbStage from '../components/LightbulbStage/index.astro';
import WritingScroll from '../components/WritingScroll/index.astro';
import { profile } from '../content/profile/site';
import './index.css';
---

<Layout title={`${profile.name} | ${profile.tagline}`} description={profile.headline}>
  <main class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content">
        <p class="hero-byline">Sagi Hammer · solving problems with personal apps</p>
        <h1 class="hero-name" id="hero-title">
          <span class="hero-line">Nothing fits you</span>
          <br />
          but you.
        </h1>
        <p class="hero-tagline">
          <span class="hero-from">From</span>
          <span>&quot;I wish this <span class="blue-underline">existed</span>.&quot;</span>
          <span class="hero-from">to</span>
          <span>&quot;I can <span class="blue-underline">build</span> that.&quot;</span>
        </p>
        <p class="hero-lede">
          Every app starts as a problem.
          <br />
          AI writes the code.{' '}
          <a href="https://apargon.com" class="hero-link" data-track="hero_link_clicked" data-track-props={JSON.stringify({ destination: 'apargon' })}>Apargon</a> runs it.
          <br />
          You just need to see the problem clearly. I’ll show you how.
        </p>
        <div class="hero-actions">
          <a href="/start" class="btn-primary" data-track="hero_cta_clicked" data-track-props={JSON.stringify({ cta: 'start_papp' })}>
            Build your first PaPP
            <Icon name="arrowRight" size={16} />
          </a>
          <a href="/projects" class="btn-ghost" data-track="hero_cta_clicked" data-track-props={JSON.stringify({ cta: 'view_projects' })}>
            See my projects
            <Icon name="arrowRight" size={16} />
          </a>
        </div>
      </div>

      <div class="hero-illustration">
        <LightbulbStage />
      </div>
    </section>

    <WritingScroll />
  </main>
</Layout>
