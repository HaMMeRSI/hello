---
import Icon from '../components/Icon/index.astro';
import Layout from '../components/Layout/index.astro';
import LightbulbStage from '../components/LightbulbStage/index.astro';
import { profile } from '../content/profile/home';
import './index.css';
---

<Layout title={`${profile.name} | Hands-on Solutions Architect`} description={profile.headline}>
  <main class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content">
        <h1 class="hero-name" id="hero-title">
          Sagi
          <br />
          Hammer
        </h1>
        <p class="hero-tagline">
          Engineer by <span class="blue-underline">mindset</span>.
          <br />
          Creator at <span class="blue-underline">heart</span>.
        </p>
        <div class="hero-actions">
          <a href="/projects" class="btn-primary" data-hero-cta="view_work">
            View My Work
            <Icon name="arrowRight" size={16} />
          </a>
          <a href="/CV/" class="btn-ghost" data-hero-cta="download_resume">
            Download Resume
            <Icon name="download" size={16} />
          </a>
        </div>
      </div>

      <div class="hero-illustration">
        <LightbulbStage />
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  function setupHeroCtas() {
    document.querySelectorAll('[data-hero-cta]').forEach(function (el) {
      el.removeEventListener('click', el._phHeroHandler);
      el._phHeroHandler = function () {
        window.posthog?.capture('hero_cta_clicked', { cta: el.dataset.heroCta });
      };
      el.addEventListener('click', el._phHeroHandler);
    });
  }

  document.addEventListener('DOMContentLoaded', setupHeroCtas);
  document.addEventListener('astro:page-load', setupHeroCtas);
</script>
