---
import Icon from '../components/Icon/index.astro';
import Layout from '../components/Layout/index.astro';
import LightbulbStage from '../components/LightbulbStage/index.astro';
import WritingScroll from '../components/WritingScroll/index.astro';
import { profile } from '../content/profile/site';
import './index.css';
---

<Layout title={`${profile.name} | ${profile.tagline}`} description={profile.headline}>
  <main class="page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-content">
        <p class="hero-byline">Sagi Hammer · solving problems with personal apps</p>
        <h1 class="hero-name" id="hero-title">
          <span class="hero-line">Nothing fits you</span>
          <br />
          but you.
        </h1>
        <p class="hero-tagline">
          &quot;I wish this <span class="red-underline">existed</span>.&quot;
          <br />
          &quot;I can <span class="red-underline">build</span> that.&quot;
        </p>
        <p class="hero-lede">
          Every app starts as a problem. AI writes the code now, so building is no longer the hard part. Seeing your problem clearly is. Solve it with a PaPP, a personal app built
          for exactly one person, and I&apos;ll show you how to start.
        </p>
        <div class="hero-actions">
          <a href="/start" class="btn-primary" data-track="hero_cta_clicked" data-track-props={JSON.stringify({ cta: 'start_papp' })}>
            Build your first PaPP
            <Icon name="arrowRight" size={16} />
          </a>
          <a href="/projects" class="btn-ghost" data-track="hero_cta_clicked" data-track-props={JSON.stringify({ cta: 'view_papps' })}>
            See my PaPPs
            <Icon name="arrowRight" size={16} />
          </a>
        </div>
      </div>

      <div class="hero-illustration">
        <LightbulbStage />
      </div>
    </section>

    <WritingScroll />
  </main>
</Layout>
