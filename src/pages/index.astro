---
import Icon from '../components/Icon.astro';
import Layout from '../components/Layout.astro';
import LightbulbStage from '../components/LightbulbStage.astro';
import { profile } from '../content/profile/home';
import './index.css';
---

<Layout title={profile.name} description={profile.headline}>
  <div class="page">
    <main class="hero">
      <div class="hero-content">
        <h1 class="hero-name">
          <span class="name-stroke">Sagi</span>
          <br />
          Hammer
        </h1>
        <p class="hero-tagline">
          Engineer by <span class="blue-underline">mindset</span>.
          <br />
          Creator at <span class="blue-underline">heart</span>.
        </p>
        <div class="hero-actions">
          <a href="/projects" class="btn-primary">
            View My Work
            <Icon name="arrowRight" size={16} />
          </a>
          <a href="/CV/" class="btn-ghost">
            Download Resume
            <Icon name="download" size={16} />
          </a>
        </div>
      </div>

      <div class="hero-illustration">
        <LightbulbStage />
      </div>
    </main>
  </div>
</Layout>
