---
import Icon from '../../components/Icon.astro';
import Layout from '../../components/Layout.astro';
import ProjectFeature from '../../components/ProjectFeature.astro';
import { profile } from '../../content/profile/site';
import { projects } from '../../content/profile/projects';
import '../../styles/story.css';
import './index.css';
---

<Layout title={`Projects | ${profile.name}`} description="Selected work by Sagi Hammer across AI agents, SaaS, media tools, VR, and AI video products.">
  <main class="story-page">
    <section class="story" aria-labelledby="projects-title">
      <header class="story-intro">
        <p class="story-kicker">things I've built</p>
        <h1 class="story-title" id="projects-title">
          Real products, <span class="ink">not demos.</span>
        </h1>
        <p class="story-lede">
          Practical builds across AI agents, finance/life tracking, local-first media tools, VR, and production AI video, focused on shipped systems with clear user value.
        </p>
        <dl class="story-meta" aria-label="Project themes">
          <div class="story-meta-item">
            <dt class="story-meta-label">theme</dt>
            <dd class="story-meta-value">shipped systems with clear user value</dd>
          </div>
          <div class="story-meta-item">
            <dt class="story-meta-label">range</dt>
            <dd class="story-meta-value">AI · SaaS · Web3 · VR · platforms</dd>
          </div>
        </dl>
      </header>

      <section class="story-section" aria-labelledby="selected-work-title">
        <div class="story-break">
          <h2 id="selected-work-title">Selected work</h2>
        </div>

        <div class="project-list">
          {projects.map((project, index) => <ProjectFeature project={project} eager={index === 0} />)}
        </div>
      </section>

      <footer class="story-next">
        <a href="/experience" class="next-link">
          <small>keep reading</small>
          <strong>
            The experience timeline
            <Icon name="arrowRight" size={24} />
          </strong>
        </a>
        <a href="/contact" class="story-aside-link">
          Jump to contact
        </a>
      </footer>
    </section>
  </main>
</Layout>
