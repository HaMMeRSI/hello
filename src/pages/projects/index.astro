---
import Layout from '../../components/Layout/index.astro';
import ProjectFeature from '../../components/ProjectFeature/index.astro';
import StoryNext from '../../components/StoryNext/index.astro';
import { profile } from '../../content/profile/site';
import { projects } from '../../content/profile/projects';
import { getAssetUrl } from '../../lib/project-media';
import '../../styles/story.css';
import './index.css';

const personId = new URL('/#person', profile.siteUrl).toString();
const projectsUrl = new URL('/projects', profile.siteUrl).toString();
const projectListId = `${projectsUrl}#project-list`;
const projectSchemaNodes = projects.map(project => {
  const projectType = project.type.toLowerCase();
  const schemaType = projectType.includes('game') ? 'VideoGame' : projectType.includes('product engineering') ? 'CreativeWork' : 'SoftwareApplication';
  const imageSrc = getAssetUrl(project.media?.find(item => item.type === 'image')?.src ?? project.cover ?? project.media?.find(item => item.poster)?.poster);
  const projectId = `${projectsUrl}#project-${project.slug}`;
  const projectPageUrl = `${projectsUrl}#project-${project.slug}-title`;

  return {
    '@type': schemaType,
    '@id': projectId,
    name: project.name,
    description: project.summary,
    url: project.url ?? projectPageUrl,
    mainEntityOfPage: {
      '@id': projectPageUrl,
    },
    creator: {
      '@id': personId,
    },
    genre: project.type,
    keywords: project.details,
    ...(schemaType === 'SoftwareApplication' ? { applicationCategory: project.type } : {}),
    ...(imageSrc ? { image: new URL(imageSrc, profile.siteUrl).toString() } : {}),
  };
});
const projectsStructuredData = [
  {
    '@type': 'ItemList',
    '@id': projectListId,
    name: 'Selected work',
    description: 'Selected AI, SaaS, and immersive XR products by Sagi Hammer.',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@id': `${projectsUrl}#project-${project.slug}`,
      },
    })),
  },
  ...projectSchemaNodes,
];
---

<Layout
  title={`${profile.name} | AI, SaaS & Web3 Projects`}
  description="Selected production work by Sagi Hammer across AI agents, SaaS, media tools, immersive XR, and AI video products."
  pageType="CollectionPage"
  breadcrumbLabel="Projects"
  pageMainEntity={projectListId}
  structuredData={projectsStructuredData}>
  <main class="story-page">
    <section class="story" aria-labelledby="projects-title">
      <header class="story-intro">
        <p class="story-kicker">things I've built</p>
        <h1 class="story-title" id="projects-title">
          Real products, <span class="ink">not demos.</span>
        </h1>
        <p class="story-lede">
          Practical builds across AI agents, finance/life tracking, local-first media tools, VR, and production AI video, focused on shipped systems with clear user value.
        </p>
        <dl class="story-meta" aria-label="Project themes">
          <div class="story-meta-item">
            <dt class="story-meta-label">theme</dt>
            <dd class="story-meta-value">shipped systems with clear user value</dd>
          </div>
          <div class="story-meta-item">
            <dt class="story-meta-label">range</dt>
            <dd class="story-meta-value">AI · SaaS · Web3 · VR · platforms</dd>
          </div>
        </dl>
      </header>

      <section class="story-section" aria-labelledby="selected-work-title">
        <div class="story-break">
          <h2 id="selected-work-title">Selected work</h2>
        </div>

        <div class="project-list">
          {projects.map((project, index) => <ProjectFeature project={project} eager={index === 0} />)}
        </div>
      </section>

      <StoryNext href="/experience" eyebrow="keep reading" label="The experience timeline" asideHref="/contact" asideLabel="Jump to contact" />
    </section>
  </main>
</Layout>
