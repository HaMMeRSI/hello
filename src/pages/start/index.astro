---
import Layout from '../../components/Layout/index.astro';
import StoryNext from '../../components/StoryNext/index.astro';
import { profile } from '../../content/profile/site';
import { era, problems, steps } from '../../content/profile/start';
import '../../styles/story.css';
import './index.css';
---

<Layout
  title={`${profile.name} | Build your first PaPP`}
  description="Solve your own problems with a PaPP, a personal app built with AI. Why now is different, which problems it solves, and how to start."
  pageType="AboutPage"
  breadcrumbLabel="Start here">
  <main class="story-page">
    <section class="story" aria-labelledby="start-title">
      <header class="story-intro">
        <p class="story-kicker">start here</p>
        <h1 class="story-title" id="start-title">
          Build your
          <br />
          <span class="ink">first PaPP.</span>
        </h1>
        <p class="story-lede">
          A PaPP is a personal app that solves one of your problems. The AI writes the code. Your job is the problem: spotting it, defining it, and checking the fix. You don&apos;t
          need to be an engineer for that.
        </p>
      </header>

      <section class="story-section" aria-labelledby="era-title">
        <div class="story-break">
          <h2 id="era-title">The new era</h2>
        </div>

        <dl class="start-era">
          {
            era.map(point => (
              <div class="start-era-point reveal">
                <dt>{point.title}</dt>
                <dd>
                  {point.body.map(paragraph => (
                    <p>{paragraph}</p>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="story-section" aria-labelledby="problems-title">
        <div class="story-break">
          <h2 id="problems-title">Problems worth solving</h2>
        </div>

        <dl class="start-problems">
          {
            problems.map(item => (
              <div class="start-problem reveal">
                <dt>{item.problem}</dt>
                <dd>{item.solution}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="story-section" aria-labelledby="steps-title">
        <div class="story-break">
          <h2 id="steps-title">How to start</h2>
        </div>

        <ol class="start-steps">
          {
            steps.map(step => (
              <li class="start-step reveal">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <StoryNext href="/projects" eyebrow="keep reading" label="See my PaPPs" asideHref="/contact" asideLabel="Stuck? Send me your problem" />
    </section>
  </main>
</Layout>
