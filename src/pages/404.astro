---
import Layout from '../components/Layout/index.astro';
import StoryNext from '../components/StoryNext/index.astro';
import { profile } from '../content/profile/site';
import '../styles/story.css';
---

<Layout title={`Page not found | ${profile.name}`} description="This page does not exist." pageType="WebPage" breadcrumbLabel="Not found" noindex>
  <main class="story-page">
    <section class="story">
      <header class="story-intro">
        <p class="story-kicker">404</p>
        <h1 class="story-title">Nothing <span class="ink">here.</span></h1>
        <p class="story-lede">This page does not exist, or it moved. The rest of the site is still where you left it.</p>
      </header>

      <StoryNext href="/" eyebrow="back to" label="The home page" asideHref="/blog" asideLabel="All posts" />
    </section>
  </main>
</Layout>
