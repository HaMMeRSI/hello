---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout/index.astro';
import StoryNext from '../../components/StoryNext/index.astro';
import { profile } from '../../content/profile/site';
import '../../styles/story.css';
import './index.css';

const posts = (await getCollection('writing')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`${profile.name} | Writing`}
  description="Essays on spotting your own problems and solving them with PaPPs, personal apps built with AI."
  pageType="CollectionPage"
  breadcrumbLabel="Writing">
  <main class="story-page">
    <section class="story" aria-labelledby="writing-title">
      <header class="story-intro">
        <p class="story-kicker">writing</p>
        <h1 class="story-title" id="writing-title">
          Problems,
          <br />
          <span class="ink">written down.</span>
        </h1>
        <p class="story-lede">Each piece starts with a problem I lived with and ends with the app that solved it. Read them in any order.</p>
      </header>

      <ol class="writing-list">
        {
          posts.map((post, index) => (
            <li class="writing-item reveal">
              <span class="writing-index">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <p class="writing-kicker">{post.data.kicker}</p>
                <h2>
                  <a href={`/writing/${post.id}`} data-track="writing_list_clicked" data-track-props={JSON.stringify({ slug: post.id })}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="writing-hook">{post.data.hook}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <StoryNext href="/start" eyebrow="done reading?" label="Build your first PaPP" asideHref="/projects" asideLabel="See my PaPPs" />
    </section>
  </main>
</Layout>
