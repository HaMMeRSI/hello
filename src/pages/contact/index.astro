---
import Icon from '../../components/Icon/index.astro';
import Layout from '../../components/Layout/index.astro';
import StoryNext from '../../components/StoryNext/index.astro';
import { contactChannels } from '../../content/profile/contact';
import { profile } from '../../content/profile/site';
import '../../styles/story.css';
import './index.css';
---

<Layout
  title={`${profile.name} | Contact`}
  description={`Tell ${profile.name} the problem you keep working around: the task you repeat every week, the spreadsheet you hate, the app that almost fits.`}
  pageType="ContactPage"
  breadcrumbLabel="Contact">
  <main class="story-page">
    <section class="story" aria-labelledby="contact-title">
      <header class="story-intro">
        <p class="story-kicker">say hello</p>
        <h1 class="story-title" id="contact-title">
          What do you <span class="ink">wish existed?</span>
        </h1>
        <p class="story-lede">
          Tell me the problem you keep working around. The task you repeat every week, the spreadsheet you hate, the app that almost fits. Stuck on how to start? Send it over, and
          I&apos;ll help you take the first step.
        </p>
        <dl class="story-meta" aria-label="Contact details">
          <div class="story-meta-item contact-clock">
            <dt class="story-meta-label contact-clock-label">
              <span class="contact-dot" aria-hidden="true"></span>
              send a message
            </dt>
            <dd class="story-meta-value contact-time" data-contact-time>--:-- Israel</dd>
          </div>
          <div class="story-meta-item">
            <dt class="story-meta-label">speaks</dt>
            <dd class="story-meta-value">Hebrew · English · Russian</dd>
          </div>
        </dl>
      </header>

      <section class="story-section" aria-labelledby="reach-out-title">
        <div class="story-break">
          <h2 id="reach-out-title">Reach out</h2>
        </div>

        <address class="contact-lines">
          {
            contactChannels.map((channel, i) => {
              const index = String(i + 1).padStart(2, '0');
              const linkProps = channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

              if (channel.copy) {
                return (
                  <div class="contact-line reveal" data-copy-line data-copied="false">
                    <span class="contact-index" aria-hidden="true">
                      {index}
                    </span>
                    <a class="contact-body" href={channel.href} data-track="contact_channel_clicked" data-track-props={JSON.stringify({ channel: channel.id })}>
                      <span class="contact-label">{channel.label}</span>
                      <span class="contact-value">{channel.value}</span>
                    </a>
                    <button type="button" class="contact-action" data-copy-value={channel.copy} aria-label="Copy email address">
                      <Icon name="copy" size={22} />
                    </button>
                  </div>
                );
              }

              return (
                <a class="contact-line reveal" href={channel.href} {...linkProps} data-track="contact_channel_clicked" data-track-props={JSON.stringify({ channel: channel.id })}>
                  <span class="contact-index" aria-hidden="true">
                    {index}
                  </span>
                  <span class="contact-body">
                    <span class="contact-label">{channel.label}</span>
                    <span class="contact-value">{channel.value}</span>
                  </span>
                  <span class="contact-arrow" aria-hidden="true">
                    <Icon name="externalLink" size={22} />
                  </span>
                </a>
              );
            })
          }
        </address>
      </section>

      <StoryNext href="/start" eyebrow="start over" label="Build your first PaPP" asideHref="/projects" asideLabel="See my PaPPs" />
    </section>
  </main>
</Layout>

<script>
  const israelTime = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jerusalem' });

  // Bundled scripts run once per session, so the page sets itself up on every visit and stops its clock on leave.
  document.addEventListener('astro:page-load', () => {
    const clock = document.querySelector<HTMLElement>('[data-contact-time]');
    if (!clock) return;

    const showTime = () => {
      clock.textContent = `${israelTime.format(new Date())} Israel`;
    };
    showTime();
    const clockTimer = window.setInterval(showTime, 15_000);
    document.addEventListener('astro:before-swap', () => window.clearInterval(clockTimer), { once: true });

    const copyLine = document.querySelector<HTMLElement>('[data-copy-line]')!;
    const copyButton = copyLine.querySelector<HTMLButtonElement>('[data-copy-value]')!;
    let resetTimer: number;

    copyButton.addEventListener('click', async () => {
      await navigator.clipboard.writeText(copyButton.dataset.copyValue!);
      copyLine.dataset.copied = 'true';
      copyButton.setAttribute('aria-label', 'Email copied to clipboard');
      window.posthog?.capture('email_copied');

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        copyLine.dataset.copied = 'false';
        copyButton.setAttribute('aria-label', 'Copy email address');
      }, 1800);
    });

    window.posthog?.capture('contact_page_viewed');
  });
</script>
