---
import Icon from '../../components/Icon/index.astro';
import Layout from '../../components/Layout/index.astro';
import StoryNext from '../../components/StoryNext/index.astro';
import { contactChannels as channels, profile } from '../../content/profile/contact';
import '../../styles/story.css';
import './index.css';
---

<Layout
  title={`${profile.name} | Contact for Full-Stack & AI Product Work`}
  description={`Contact ${profile.name} for software engineering, AI product, and platform work.`}
  pageType="ContactPage"
  breadcrumbLabel="Contact">
  <main class="story-page">
    <section class="story" aria-labelledby="contact-title">
      <header class="story-intro">
        <p class="story-kicker">say hello</p>
        <h1 class="story-title" id="contact-title">
          Let's build <span class="ink">the hard part.</span>
        </h1>
        <p class="story-lede">
          If you&apos;re building something ambitious and need someone who can move between product, code, and messy unknowns, reach out. I&apos;m easy to start with: send the
          problem, the context, and where you want to get.
        </p>
        <dl class="story-meta" aria-label="Contact details">
          <div class="story-meta-item contact-clock">
            <dt class="story-meta-label contact-clock-label">
              <span class="contact-dot" aria-hidden="true"></span>
              send a message
            </dt>
            <dd class="story-meta-value contact-time" data-contact-time>--:-- Israel</dd>
          </div>
          <div class="story-meta-item">
            <dt class="story-meta-label">speaks</dt>
            <dd class="story-meta-value">Hebrew · English · Russian</dd>
          </div>
        </dl>
      </header>

      <section class="story-section" aria-labelledby="reach-out-title">
        <div class="story-break">
          <h2 id="reach-out-title">Reach out</h2>
        </div>

        <address class="contact-lines">
          {
            channels.map((channel, i) => {
              const index = String(i + 1).padStart(2, '0');
              const linkProps = channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};

              if (channel.copy) {
                return (
                  <div class="contact-line reveal" data-copy-line data-copied="false" data-channel-id={channel.id}>
                    <span class="contact-index" aria-hidden="true">
                      {index}
                    </span>
                    <a class="contact-body" href={channel.href} data-contact-link data-channel-id={channel.id}>
                      <span class="contact-label">{channel.label}</span>
                      <span class="contact-value">{channel.value}</span>
                    </a>
                    <button type="button" class="contact-action" data-copy-value={channel.copy} aria-label="Copy email address">
                      <Icon name="copy" size={22} />
                    </button>
                  </div>
                );
              }

              return (
                <a class="contact-line reveal" href={channel.href} {...linkProps} data-contact-link data-channel-id={channel.id}>
                  <span class="contact-index" aria-hidden="true">
                    {index}
                  </span>
                  <span class="contact-body">
                    <span class="contact-label">{channel.label}</span>
                    <span class="contact-value">{channel.value}</span>
                  </span>
                  <span class="contact-arrow" aria-hidden="true">
                    <Icon name="externalLink" size={22} />
                  </span>
                </a>
              );
            })
          }
        </address>
      </section>

      <StoryNext href="/" eyebrow="start over" label="Back home" asideHref="/projects" asideLabel="Review the work again" />
    </section>
  </main>
</Layout>

<script>
  const timeFormatter = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Asia/Jerusalem',
  });

  const timeElements = document.querySelectorAll<HTMLElement>('[data-contact-time]');
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy-value]');
  const cleanupController = new AbortController();
  const resetTimers = new Map<HTMLElement, number>();

  const setCopyState = (button: HTMLButtonElement, line: HTMLElement, copied: boolean) => {
    line.dataset.copied = String(copied);
    button.setAttribute('aria-label', copied ? 'Email copied to clipboard' : 'Copy email address');
  };

  const updateTime = () => {
    const localTime = `${timeFormatter.format(new Date())} Israel`;
    timeElements.forEach(element => {
      element.textContent = localTime;
    });
  };

  const queueCopyReset = (button: HTMLButtonElement, line: HTMLElement) => {
    window.clearTimeout(resetTimers.get(line));

    const resetTimer = window.setTimeout(() => {
      resetTimers.delete(line);
      setCopyState(button, line, false);
    }, 1800);

    resetTimers.set(line, resetTimer);
  };

  const copyValue = async (button: HTMLButtonElement) => {
    const text = button.dataset.copyValue;
    if (!text) return;

    try {
      await navigator.clipboard.writeText(text);
      const line = button.closest<HTMLElement>('[data-copy-line]');
      if (!line) return;

      setCopyState(button, line, true);
      queueCopyReset(button, line);

      window.posthog?.capture('email_copied');
    } catch {
      return;
    }
  };

  updateTime();
  const timeInterval = window.setInterval(updateTime, 15_000);

  copyButtons.forEach(button => {
    button.addEventListener('click', () => void copyValue(button), { signal: cleanupController.signal });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-contact-link]').forEach(link => {
    link.addEventListener(
      'click',
      () => {
        const channelId = link.dataset.channelId ?? '';
        if (channelId === 'cv') {
          window.posthog?.capture('resume_download_clicked', { source: 'contact_page' });
        }
        window.posthog?.capture('contact_channel_clicked', { channel: channelId });
      },
      { signal: cleanupController.signal }
    );
  });

  window.posthog?.capture('contact_page_viewed');

  document.addEventListener(
    'astro:before-swap',
    () => {
      cleanupController.abort();
      window.clearInterval(timeInterval);
      resetTimers.forEach(timer => window.clearTimeout(timer));
      resetTimers.clear();
    },
    { once: true }
  );
</script>
