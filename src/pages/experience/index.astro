---
import Layout from '../../components/Layout/index.astro';
import StoryNext from '../../components/StoryNext/index.astro';
import { profile } from '../../content/profile/site';
import { education, experience } from '../../content/profile/experience';
import '../../styles/story.css';
import './index.css';
---

<Layout
  title={`${profile.name} | Story`}
  description="Ten years of production software, from the army through a VR startup to AI video at D-ID and an AI startup. Now building PaPPs, personal apps, and helping others start theirs."
  pageType="AboutPage"
  breadcrumbLabel="Story">
  <main class="story-page">
    <section class="story" aria-labelledby="experience-title">
      <header class="story-intro">
        <p class="story-kicker">how I got here</p>
        <h1 class="story-title" id="experience-title">
          The road,
          <br />
          <span class="ink">so far.</span>
        </h1>
        <p class="story-lede">
          Ten years of production software. In the army, at a VR startup I co-founded, at D-ID, at an AI startup. I know what a product for millions needs. That&apos;s how I know a
          PaPP needs about 10% of it, and which 10%.
        </p>
        <dl class="story-meta" aria-label="Story highlights">
          <div class="story-meta-item">
            <dt class="story-meta-label">now</dt>
            <dd class="story-meta-value">building PaPPs, and helping others start theirs</dd>
          </div>
          <div class="story-meta-item">
            <dt class="story-meta-label">proof</dt>
            <dd class="story-meta-value">Gepeta · Writor · Chapeta · TimeLion</dd>
          </div>
        </dl>
      </header>

      <section class="story-section" aria-labelledby="timeline-title">
        <div class="story-break">
          <h2 id="timeline-title">The timeline</h2>
        </div>

        <div class="journey">
          {
            experience.map(item => (
              <article class="milestone reveal">
                <p class="milestone-period">{item.period}</p>
                <h3 class="milestone-company">{item.company}</h3>
                <p class="milestone-role">{item.role}</p>
                <p class="milestone-summary">{item.summary}</p>
                <ul class="milestone-points">
                  {item.points.map(point => (
                    <li>{point}</li>
                  ))}
                </ul>
                <p class="milestone-stack">{item.stack.join('  ·  ')}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="story-section" aria-labelledby="foundations-title">
        <div class="story-break">
          <h2 id="foundations-title">Foundations</h2>
        </div>

        <ul class="footnotes reveal">
          {
            education.map(item => (
              <li class="footnote">
                <strong>{item.school}</strong>
                <span>{item.credential}</span>
                <em>{item.period}</em>
              </li>
            ))
          }
        </ul>
      </section>

      <StoryNext href="/contact" eyebrow="last chapter" label="Write to me" asideHref="/CV/" asideLabel="The traditional CV" />
    </section>
  </main>
</Layout>
