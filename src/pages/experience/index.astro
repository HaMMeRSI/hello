---
import Layout from '../../components/Layout/index.astro';
import StoryNext from '../../components/StoryNext/index.astro';
import { profile } from '../../content/profile/site';
import { education, experience } from '../../content/profile/experience';
import '../../styles/story.css';
import './index.css';
---

<Layout
  title={`${profile.name} | Full-Stack & AI Engineering Experience`}
  description="Sagi Hammer's software engineering experience across AI products, defense, startups, 3D, XR, and product platforms."
  pageType="AboutPage"
  breadcrumbLabel="Experience">
  <main class="story-page">
    <section class="story" aria-labelledby="experience-title">
      <header class="story-intro">
        <h1 class="story-title" id="experience-title">
          The road,
          <br />
          <span class="ink">so far.</span>
        </h1>
        <p class="story-lede">
          For 10 years, I&apos;ve built end-to-end software across defense, AI video, AI harnesses, agents, automation infrastructure, media, and XR, taking projects from unclear
          requirements through system design, infrastructure, implementation, and launch.
        </p>
        <dl class="story-meta" aria-label="Experience highlights">
          <div class="story-meta-item">
            <dt class="story-meta-label">now</dt>
            <dd class="story-meta-value">Q.E.D Science + independent AI products</dd>
          </div>
          <div class="story-meta-item">
            <dt class="story-meta-label">proof</dt>
            <dd class="story-meta-value">Q.E.D Science · Chapeta · Gepeta · FastEdit · D-ID · Terragon</dd>
          </div>
        </dl>
      </header>

      <section class="story-section" aria-labelledby="timeline-title">
        <div class="story-break">
          <h2 id="timeline-title">The timeline</h2>
        </div>

        <div class="journey">
          {
            experience.map(item => (
              <article class="milestone reveal">
                <p class="milestone-period">{item.period}</p>
                <h3 class="milestone-company">{item.company}</h3>
                <p class="milestone-role">{item.role}</p>
                <p class="milestone-summary">{item.summary}</p>
                <ul class="milestone-points">
                  {item.points.map(point => (
                    <li>{point}</li>
                  ))}
                </ul>
                <p class="milestone-stack">{item.stack.join('  ·  ')}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="story-section" aria-labelledby="foundations-title">
        <div class="story-break">
          <h2 id="foundations-title">Foundations</h2>
        </div>

        <ul class="footnotes reveal">
          {
            education.map(item => (
              <li class="footnote">
                <strong>{item.school}</strong>
                <span>{item.credential}</span>
                <em>{item.period}</em>
              </li>
            ))
          }
        </ul>
      </section>

      <StoryNext href="/stack" eyebrow="keep reading" label="The technical stack" asideHref="/contact" asideLabel="Jump to contact" />
    </section>
  </main>
</Layout>
