---
import Layout from '../../components/Layout/index.astro';
import StoryNext from '../../components/StoryNext/index.astro';
import { profile } from '../../content/profile/site';
import { skillGroups } from '../../content/profile/stack';
import '../../styles/story.css';
import './index.css';
---

<Layout
  title={`${profile.name} | AI, Cloud, XR & Web3 Engineering Stack`}
  description="Sagi Hammer's technical range across frontend, backend, cloud, AI, XR, games, and Web3."
  pageType="AboutPage"
  breadcrumbLabel="Skills">
  <main class="story-page">
    <section class="story" aria-labelledby="stack-title">
      <header class="story-intro">
        <p class="story-kicker">what I build with</p>
        <h1 class="story-title" id="stack-title">
          Range,
          <br />
          <span class="ink">with taste.</span>
        </h1>
        <p class="story-lede">
          Frontend, backend, cloud, AI, game/XR, and on-chain systems. I care less about naming every tool and more about picking the right one, shipping cleanly, and keeping the
          work maintainable.
        </p>
        <dl class="story-meta" aria-label="Technical focus">
          <div class="story-meta-item">
            <dt class="story-meta-label">core</dt>
            <dd class="story-meta-value">TypeScript · React · APIs · systems</dd>
          </div>
          <div class="story-meta-item">
            <dt class="story-meta-label">edges</dt>
            <dd class="story-meta-value">agents · OpenXR · Unity · Solana</dd>
          </div>
        </dl>
      </header>

      <section class="story-section" aria-labelledby="technical-range-title">
        <div class="story-break">
          <h2 id="technical-range-title">Technical range</h2>
        </div>

        <dl class="capabilities">
          {
            skillGroups.map(group => (
              <div class="capability reveal">
                <dt>{group.title}</dt>
                <dd>
                  <p>{group.summary}</p>
                  <p class="capability-skills">{group.skills.join('  ·  ')}</p>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <StoryNext href="/contact" eyebrow="last chapter" label="Let's talk" asideHref="/contact" asideLabel="Jump to contact" />
    </section>
  </main>
</Layout>
