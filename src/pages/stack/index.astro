---
import Icon from '../../components/Icon.astro';
import Layout from '../../components/Layout.astro';
import { profile } from '../../content/profile/site';
import { skillGroups } from '../../content/profile/stack';
import '../../styles/story.css';
import './index.css';
---

<Layout title={`Stack | ${profile.name}`} description="Sagi Hammer's technical range across frontend, backend, cloud, AI, XR, games, and Web3.">
  <main class="story-page">
    <div class="story">
      <header class="story-intro">
        <p class="story-kicker">what I build with</p>
        <h1 class="story-title">
          Range, <br/><span class="ink">with taste.</span>
        </h1>
        <p class="story-lede">
          Frontend, backend, cloud, AI, game/XR, and on-chain systems. I care less about naming every tool and more about picking the right one, shipping cleanly,
          and keeping the work maintainable.
        </p>
        <div class="story-meta" aria-label="Technical focus">
          <span class="story-meta-item">
            <span class="story-meta-label">core</span> TypeScript · React · APIs · systems
          </span>
          <span class="story-meta-item">
            <span class="story-meta-label">edges</span> agents · OpenXR · Unity · Solana
          </span>
        </div>
      </header>

      <header class="story-break">
        <h2>Technical range</h2>
      </header>

      <dl class="capabilities">
        {
          skillGroups.map(group => (
            <div class="capability reveal">
              <dt>{group.title}</dt>
              <dd>
                <p>{group.summary}</p>
                <p class="capability-skills">{group.skills.join('  ·  ')}</p>
              </dd>
            </div>
          ))
        }
      </dl>

      <footer class="story-next">
        <a href="/contact" class="next-link">
          <small>last chapter</small>
          <strong>
            Let's talk
            <Icon name="arrowRight" size={24} />
          </strong>
        </a>
        <a href="/contact" class="story-aside-link">
          Jump to contact
        </a>
      </footer>
    </div>
  </main>
</Layout>
